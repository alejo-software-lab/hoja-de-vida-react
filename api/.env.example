# Configuración de la API de contacto (copia a .env para desarrollo local)

# Puerto del servicio Node
PORT=3001

# Resend — API key SOLO del lado servidor. Consíguela en https://resend.com
RESEND_API_KEY=re_tu_api_key

# Buzón que recibe los mensajes del formulario
MAIL_TO=alejosoftwarelabs@gmail.com

# Remitente. Con dominio verificado en Resend usa algo como "CV <no-reply@tudominio.com>".
# Sin dominio propio, deja el sandbox de Resend:
MAIL_FROM=CV Website <onboarding@resend.dev>

# CORS: orígenes permitidos en producción, separados por coma.
# Ej: https://tu-sitio.onrender.com
ALLOWED_ORIGINS=

# (Opcional) Cloudflare Turnstile — captcha anti-bot. Si lo dejas vacío, se desactiva.
# TURNSTILE_SECRET=0x0000000000000000000000000000000000000000
