# Configuración del backend (copia este archivo a .env y completa tus datos)
# Si NO configuras el SMTP, los mensajes se guardan en server/messages.json

# Puerto del servidor
PORT=3001

# Datos del servicio de correo (ej. Gmail, Outlook, SendGrid, Mailtrap)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario@correo.com
SMTP_PASS=tu_contraseña_o_token

# Correo que recibe los mensajes del formulario
MAIL_TO=Alejandromg94@outlook.com
MAIL_FROM=tu_usuario@correo.com
