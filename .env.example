# Variables del FRONTEND (Vite). Copia a .env.local para desarrollo.
# Nota: todo lo que empiece por VITE_ queda EXPUESTO en el bundle público.
# NUNCA pongas aquí claves de correo/Resend — esas viven en api/.env (servidor).

# URL del API de contacto. En dev déjalo vacío: el proxy de Vite enruta /api
# al servicio Node local (http://localhost:3001).
VITE_API_URL=

# (Opcional) Cloudflare Turnstile — clave pública del sitio (site key).
# Déjalo vacío para desactivar el captcha.
# VITE_TURNSTILE_SITE_KEY=
